TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-server-token
# Optional: a separate random secret keeps login sessions independent of database token rotation.
BETTER_AUTH_SECRET=
# Optional: set this to the production origin if you use a custom domain.
BETTER_AUTH_URL=
# Optional: Google Maps JavaScript + browser Geocoding. Restrict this public
# browser key to Pocket's website origins and the Maps JavaScript/Geocoding APIs.
GOOGLE_MAPS_BROWSER_KEY=
# Optional: OpenRouter model for JEV's hosted barrel-throw decisions in Girder
# Run. The player's own OpenRouter key, saved in Pip settings, is used; there is
# no shared Pocket key. The game falls back to its local model without one.
OPENROUTER_JEV_MODEL=typesafe/jev-1.14
