TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-server-token
# Optional: a separate random secret keeps login sessions independent of database token rotation.
BETTER_AUTH_SECRET=
# Optional: set this to the production origin if you use a custom domain.
BETTER_AUTH_URL=
# Optional: Google Maps JavaScript + browser Geocoding. Restrict this public
# browser key to Pocket's website origins and the Maps JavaScript/Geocoding APIs.
GOOGLE_MAPS_BROWSER_KEY=
# Optional: OpenRouter model for JEV's hosted decisions in Girder Run and
# Shadow Protocol. The player's own OpenRouter key, saved in Pip settings, is
# used; there is no shared Pocket key. The games fall back to their local model
# without one.
OPENROUTER_JEV_MODEL=typesafe/jev-1.14
# Optional: run Pip's replies on a detached worker instead of inside the web
# request. Set PIP_RUNS_DETACHED=1 in the web app; the worker (npm run worker)
# needs only the three secrets above. See services/pip/README.md.
PIP_RUNS_DETACHED=
# Optional worker tuning: parallel stretches, poll interval, job lease length,
# retry limit, health port, and how long a queued run may wait for a worker.
PIP_WORKER_CONCURRENCY=
PIP_WORKER_POLL_MS=
PIP_WORKER_JOB_LEASE_MS=
PIP_WORKER_MAX_ATTEMPTS=
PIP_WORKER_PORT=
PIP_QUEUE_TTL_MS=
# Optional: let the worker run scheduled routines itself (ms between checks, 0 = off).
# 60000 lands a check-in, brief or watch within a minute of its time instead of a cron's 15.
PIP_ROUTINES_EVERY_MS=
