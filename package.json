{
  "name": "pocket-phone",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "worker": "node --env-file-if-exists=.env services/pip/worker.mjs",
    "worker:once": "node --env-file-if-exists=.env services/pip/worker.mjs --once",
    "db:setup": "node --env-file=.env scripts/db-setup.mjs",
    "typecheck": "tsc -p tsconfig.app.json",
    "test": "vitest run",
    "test:tools": "node --test \"tools/**/*.test.mjs\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@astrojs/react": "^7.1.0",
    "@astrojs/vercel": "11.0.12",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@json-render/react": "^0.22.0",
    "@libsql/client": "0.18.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-router": "1.170.46",
    "ai": "7.0.136",
    "astro": "7.3.6",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satteri": "0.10.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@json-render/chat": "^0.22.0",
    "@json-render/core": "^0.22.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
