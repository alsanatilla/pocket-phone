---
import '../styles/pocket.css';
import '../client/retro-loading.css';
import '../client/daily-brief.css';
import '../client/setup.css';
import '../styles/warm-console.css';
import '../styles/travel-sharing.css';
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#12110f" />
    <meta name="color-scheme" content="dark" />
    <title>pocket</title>
    <link rel="preload" href="/fonts/VT323-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div id="app" class="app"><noscript>Pocket needs JavaScript.</noscript></div>
    <div id="dialog" class="dialog" hidden></div>
    <script>import '../client/app.js';</script>
  </body>
</html>
