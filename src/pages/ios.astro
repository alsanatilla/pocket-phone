---
// Pocket on the iPhone: adding it to the home screen, and the key the Scriptable widget and the "Send to Pip"
// shortcut use. It is drawn with the app's own blocks and styles (docs/DESIGN.md), rendered once at build time; the
// two keys talk to /api/ios/key from the small script below, nothing else on the page runs.
import "../app/styles/global.css";
import { Button, buttonVariants } from "../app/components/ui/button";
import { SectionLabel } from "../app/ui/kit.tsx";
import { PageTitle } from "../app/ui/PageTitle.tsx";
export const prerender = true;
const STEPS = "list-decimal space-y-2 pl-5 text-sm marker:text-dim";
const CODE = "rounded-[5px] bg-secondary px-1 text-hi [overflow-wrap:anywhere]";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#12110f" />
  <meta name="color-scheme" content="dark" />
  <title>pocket on iPhone</title>
</head>
<body>
  <main class="mx-auto max-w-[640px] px-4 pt-4 pb-16">
    <a href="/" class={buttonVariants()}>‹ pocket</a>
    <PageTitle title="pocket on iPhone" meta="Home screen, widget and shortcut." />

    <section class="mt-6">
      <SectionLabel>home screen</SectionLabel>
      <p class="text-sm">Open Pocket in Safari and choose Share, then Add to Home Screen. Start Pocket from the new icon and sign in.</p>
    </section>

    <section class="mt-6">
      <SectionLabel>key for the widget and the shortcut</SectionLabel>
      <p class="text-sm">Sign in to Pocket first. This key lets the widget read your next task and the shortcut send to Pip. It lasts 90 days, a new key replaces the old one, and it is yours alone: keep it private.</p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <Button id="create" variant="go">create key</Button>
        <Button id="revoke" variant="destructive" className="ml-auto">revoke key</Button>
      </div>
      <p id="status" role="status" class="mt-2 text-xs text-muted-foreground"></p>
      <textarea id="key" readonly aria-label="Your new key" rows="3" hidden
        class="mt-1 w-full resize-none rounded-[5px] bg-secondary p-2 text-sm text-hi [overflow-wrap:anywhere] outline-none"></textarea>
    </section>

    <section class="mt-6">
      <SectionLabel>widget</SectionLabel>
      <ol class={STEPS}>
        <li>Install Scriptable on your iPhone.</li>
        <li>Copy <a href="/pocket-widget.js" class="text-primary underline underline-offset-2">this script</a> into a new Scriptable script.</li>
        <li>Run it once and enter your Pocket address and the key.</li>
        <li>Add a Scriptable widget to the home screen and choose the script.</li>
      </ol>
      <p class="mt-3 text-sm text-muted-foreground">It shows your synced next task. iOS decides when widgets refresh. The script is meant for the home screen.</p>
    </section>

    <section class="mt-6">
      <SectionLabel>“send to pip” shortcut</SectionLabel>
      <ol class={STEPS}>
        <li>In Shortcuts, make a shortcut with “Ask for Input” (text). To use it from the share sheet, turn on “Show in Share Sheet” and use the shortcut input instead.</li>
        <li>Add “Get Contents of URL”. URL: <code id="endpoint" class={CODE}></code>, method: POST.</li>
        <li>Set the header <code class={CODE}>Authorization</code> to <code class={CODE}>Bearer YOUR_KEY</code>. Choose JSON as the request body and add the text field <code class={CODE}>text</code> with your input.</li>
        <li>Name it “Send to Pip”. Siri can start it too.</li>
      </ol>
      <p class="mt-3 text-sm text-muted-foreground">Pip has to be set up to work on Pocket's server. A request that arrives is accepted; the answer appears in the chat in Pocket, and approvals are made there. Do not share the shortcut with the key inside it.</p>
    </section>
  </main>
  <script>
    const output = document.querySelector<HTMLTextAreaElement>('#key')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    document.querySelector('#endpoint')!.textContent = location.origin + '/api/ios/message';
    async function change(method: string) {
      const buttons = document.querySelectorAll<HTMLButtonElement>('main button'); buttons.forEach(b => b.disabled = true);
      output.hidden = true; output.value = '';
      try {
        const r = await fetch('/api/ios/key', { method }); const data = await r.json();
        if (!r.ok) throw new Error(data.error);
        if (data.key) { output.value = data.key; output.hidden = false; }
        status.textContent = data.key ? 'Copy it now. The key is shown only once.' : 'The key is revoked.';
      } catch (e) { status.textContent = e instanceof Error ? e.message : 'Pocket could not be reached. Try again.'; }
      finally { buttons.forEach(b => b.disabled = false); }
    }
    document.querySelector('#create')!.addEventListener('click', () => change('POST'));
    document.querySelector('#revoke')!.addEventListener('click', () => change('DELETE'));
  </script>
</body>
</html>
