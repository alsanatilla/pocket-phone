---
// The new client used to live here while it was being built; it is Pocket's home now. Old links keep working:
// the hash (the in-app path) travels along.
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <script is:inline>location.replace('/' + location.search + location.hash);</script>
    <noscript><meta http-equiv="refresh" content="0; url=/" /></noscript>
  </head>
  <body></body>
</html>
